{
  "expo": {
    "name": "LabUnj",
    "slug": "labunj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_unj.png",
    "scheme": "labunj",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo_unj.png",
        "backgroundImage": "./assets/images/logo_unj.png",
        "monochromeImage": "./assets/images/logo_unj.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi memerlukan akses kamera untuk scan QR barang."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/logo_unj.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0796904-c5d4-41b7-80b3-22e1ede4b2a9"
      }
    },
    "owner": "afisabillah"
  }
}
